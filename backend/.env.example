PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/book_ecommerce

# JWT secrets - use long random strings, keep the same values the frontend uses to verify tokens
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Seed admin account (used once by `npm run seed:admin`)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change_me_admin_password

# WhatsApp number the checkout deep link should target (country code, digits only, e.g. 15551234567)
WHATSAPP_NUMBER=15551234567

# Origin(s) allowed to call this API - the Next.js server's own origin, not a browser origin
CORS_ORIGIN=http://localhost:3000

# Optional: raises the anonymous Google Books rate limit
GOOGLE_BOOKS_API_KEY=

# Gmail SMTP - sends "forgot password" reset code emails. GMAIL_APP_PASSWORD
# is NOT your normal Gmail password: generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be turned on for the account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# "Sign in with Google" - OAuth 2.0 Client ID from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID >
# Web application). Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID
# exactly - this is a public identifier, not a secret.
GOOGLE_CLIENT_ID=

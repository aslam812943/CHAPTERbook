EXPRESS_API_URL=http://localhost:5000/api

# Used for sitemap.ts/robots.ts URLs and metadataBase (OG/canonical link
# resolution). Set to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the backend's JWT_ACCESS_SECRET / JWT_REFRESH_SECRET exactly
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# WhatsApp number the checkout deep link should target (country code, digits only)
WHATSAPP_NUMBER=15551234567
# Same number, exposed to the browser bundle for the footer's WhatsApp button
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567

# "Sign in with Google" - same OAuth Client ID as the backend's
# GOOGLE_CLIENT_ID. Public identifier, safe to expose to the browser (that's
# what NEXT_PUBLIC_ means here - it's not a secret like a client secret would be).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
